# ASP.NET Core maps double underscores to nested configuration keys.
# Copy to .env; it is loaded at startup via DotNetEnv (real environment variables take precedence).
ASPNETCORE_ENVIRONMENT=Development
MongoDb__ConnectionString=mongodb://localhost:27017
MongoDb__DatabaseName=smart_solar_microgrid
Jwt__Key=change-me-to-a-random-secret-of-at-least-32-chars
Cors__AllowedOrigins__0=http://localhost:5173

