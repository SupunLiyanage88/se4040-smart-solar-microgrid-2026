<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Reference copy of the palette used in Kotlin (ProsumerAccountActivity.kt,
      MainActivity.kt use Color.rgb(...) constants directly, not these resources,
      since the UI is built with plain Views, not XML layouts/themes). Kept here so
      the values are documented in one obvious place and match the web app's
      web/src/App.css exactly. Update both places together if the palette changes.
    -->
    <color name="solar_green">#226D50</color>          <!-- primary buttons, matches web .btn-primary -->
    <color name="solar_green_dark">#143D30</color>     <!-- header bar, matches web .site-header -->
    <color name="solar_green_hover">#174E39</color>    <!-- pressed state, matches web .btn-primary hover -->
    <color name="solar_muted_green">#39785E</color>    <!-- secondary/eyebrow labels -->
    <color name="solar_background">#F4F7F4</color>
    <color name="solar_body_text">#20352C</color>
    <color name="solar_error">#A02828</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Added for UI polish: derived from the palette above, used only from Kotlin
         (GradientDrawable/StateListDrawable), still no XML layouts. -->
    <color name="solar_surface">#FFFFFF</color>              <!-- card/input backgrounds -->
    <color name="solar_border">#D7E2DC</color>                <!-- input/card borders, idle -->
    <color name="solar_border_focused">#226D50</color>        <!-- input border, focused (= solar_green) -->
    <color name="solar_disabled">#B7C4BD</color>              <!-- disabled button fill -->
    <color name="solar_status_pending_bg">#FDF3D9</color>
    <color name="solar_status_pending_fg">#8A6116</color>
    <color name="solar_status_approved_bg">#E1F3EA</color>
    <color name="solar_status_approved_fg">#1C7A4C</color>
    <color name="solar_status_completed_bg">#E4ECF7</color>
    <color name="solar_status_completed_fg">#2C4F87</color>
    <color name="solar_status_negative_bg">#FBE7E7</color>
    <color name="solar_status_negative_fg">#A02828</color>
</resources>
