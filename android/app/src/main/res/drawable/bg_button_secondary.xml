<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/solar_background" />
            <stroke android:width="1dp" android:color="@color/solar_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/solar_disabled" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/solar_surface" />
            <stroke android:width="1dp" android:color="@color/solar_border" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
